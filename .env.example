# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cross_lender
# Required by SEC: your name and email
SEC_USER_AGENT=Your Name your.email@example.com
# ISO date of the measured quarter, set on Day 1 after BDC scouting
MEASURED_PERIOD_END=
# Labeling endpoint (E12). Keep false except in a local override while labeling.
ENABLE_LABELING=false
# Public demo: set true to reject all API methods except GET and HEAD.
READ_ONLY=false
# Postgres password used by docker compose (defaults to postgres for local use; set a real one before deploying)
POSTGRES_PASSWORD=
# API port
PORT=3000
